{%- comment -%}
  FIXTURE — DIVERGENT COPY, ADDITIVE SCHEMA (site-c only).

  site-c's local version adds a schema setting that shopify-common does NOT
  have: `hide_background`. This is the sandbox stand-in for the real decision
  taken during the skinstylus migration — a site had extra, genuinely useful
  schema options, and the ruling was that common wins and the extras are
  dropped rather than merged.

  Expected behaviour after a code deploy:
    - This file is overwritten by common's version.
    - `hide_background` vanishes from the theme editor.
    - Any content JSON that set `hide_background` keeps the orphaned key
      harmlessly (Shopify ignores unknown settings) — worth confirming, since
      it is the thing people fear when dropping a setting.
{%- endcomment -%}

{% liquid
  assign s = section.settings
%}

<div
  class="sandbox-footer-cta"
  data-sandbox-origin="SITE-C-VERSION"
  style="padding: {{ s.padding }}px 20px;{% unless s.hide_background %} background: #eef4ff;{% endunless %}"
>
  {%- if s.heading != blank -%}
    <h2 class="sandbox-footer-cta__heading">{{ s.heading }}</h2>
  {%- endif -%}

  {%- if s.cta_label != blank and s.cta_url != blank -%}
    <a class="sandbox-footer-cta__button button" href="{{ s.cta_url }}">{{ s.cta_label }}</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.sandbox-footer-cta.name",
  "tag": "section",
  "class": "sandbox-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.sandbox-footer-cta.settings.heading", "default": "Ready to go?" },
    { "type": "text", "id": "cta_label", "label": "t:sections.sandbox-footer-cta.settings.cta_label", "default": "Get started" },
    { "type": "url", "id": "cta_url", "label": "t:sections.sandbox-footer-cta.settings.cta_url" },
    { "type": "checkbox", "id": "hide_background", "label": "Hide background colour", "default": false },
    { "type": "range", "id": "padding", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.sandbox-footer-cta.settings.padding", "default": 32 }
  ],
  "presets": [{ "name": "t:sections.sandbox-footer-cta.name" }]
}
{% endschema %}
